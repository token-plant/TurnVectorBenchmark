{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://token-plant.github.io/TurnVectorBenchmark/schemas/certification-record-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "subject_build_identity", "protocol_version", "issued_at", "expires_at", "environment_identity", "matrix_applicability", "thresholds"],
  "properties": {
    "schema_version": {"const": "turnvector.benchmark.certification-record.v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "subject_build_identity": {"type": "string", "minLength": 1},
    "protocol_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "environment_identity": {"type": "object", "minProperties": 1},
    "matrix_applicability": {
      "type": "object",
      "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true}
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {"type": "number"}
      }
    }
  }
}
