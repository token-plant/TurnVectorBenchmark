{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://token-plant.github.io/TurnVectorBenchmark/schemas/case-schema-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lane_id", "matrices"],
  "properties": {
    "schema_version": {"const": "turnvector.benchmark.case-schema.v1"},
    "lane_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "matrices": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["required", "properties", "additional_properties"],
        "properties": {
          "required": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "properties": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enum"],
              "properties": {"enum": {"type": "array", "minItems": 1, "uniqueItems": true}}
            }
          },
          "additional_properties": {"const": false}
        }
      }
    }
  }
}
