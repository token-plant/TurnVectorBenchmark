{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/token-plant/TurnVectorBenchmark/schemas/suite-v1.schema.json",
  "title": "TurnVector benchmark suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "description", "scenarios"],
  "properties": {
    "schema_version": {
      "const": "turnvector.benchmark.suite.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
