{
  "schema_version": "turnvector.benchmark.case-schema.v1",
  "lane_id": "bounded-turn-and-ffi",
  "matrices": {
    "decode-boundary": {
      "required": ["model_architecture", "batch_size", "context_tokens", "boundary"],
      "properties": {
        "model_architecture": {"enum": ["dense", "moe"]},
        "batch_size": {"enum": [1, 4]},
        "context_tokens": {"enum": [512, 2048, 8192]},
        "boundary": {"enum": ["cpp_direct_oracle", "implementation_candidate"]}
      },
      "additional_properties": false
    },
    "prefill-boundary": {
      "required": ["model_architecture", "prompt_tokens", "boundary"],
      "properties": {
        "model_architecture": {"enum": ["dense", "moe"]},
        "prompt_tokens": {"enum": [64, 256, 1024]},
        "boundary": {"enum": ["cpp_direct_oracle", "implementation_candidate"]}
      },
      "additional_properties": false
    }
  }
}
