{
  "$defs": {
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "git_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "type": "string"
    },
    "ids": {
      "items": {
        "$ref": "#/$defs/id"
      },
      "type": "array",
      "uniqueItems": true
    },
    "nonempty": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "nonnegative_integer": {
      "minimum": 0,
      "type": "integer"
    },
    "positive_integer": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "$id": "https://token-plant.github.io/TurnVectorBenchmark/schemas/openai-serving-endpoint-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_flavor": {
      "const": "chat_completions"
    },
    "authentication_env_var": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "type": "string"
        }
      ]
    },
    "base_url": {
      "pattern": "^http://(?:127(?:\\.(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})){3}|\\[::1\\]):(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])/v1$",
      "type": "string"
    },
    "capability_report_sha256": {
      "$ref": "#/$defs/digest"
    },
    "model_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^[^\\u0000-\\u001f]+$",
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "process_ids": {
      "items": {
        "minimum": 1,
        "type": "integer"
      },
      "maxItems": 1024,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "protocol_family": {
      "const": "openai-compatible"
    },
    "protocol_version": {
      "const": "turnvector.benchmark.openai-serving.v1"
    },
    "stream_format": {
      "const": "sse-data-json"
    },
    "transport": {
      "const": "http"
    }
  },
  "required": [
    "protocol_family",
    "protocol_version",
    "transport",
    "base_url",
    "api_flavor",
    "stream_format",
    "model_ids",
    "process_ids",
    "capability_report_sha256",
    "authentication_env_var"
  ],
  "type": "object"
}
