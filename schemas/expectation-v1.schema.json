{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/token-plant/TurnVectorBenchmark/schemas/expectation-v1.schema.json",
  "title": "TurnVector implementation benchmark expectation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "description",
    "source_contract",
    "certification_policy",
    "lanes"
  ],
  "properties": {
    "schema_version": {
      "const": "turnvector.benchmark.expectation.v1"
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "description": {
      "$ref": "#/$defs/nonemptyString"
    },
    "source_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "clean_required"],
      "properties": {
        "repository": {
          "$ref": "#/$defs/nonemptyString"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "clean_required": {
          "type": "boolean"
        }
      }
    },
    "certification_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_lane_policy",
        "contract_only_policy",
        "scope_policy"
      ],
      "properties": {
        "required_lane_policy": {
          "const": "all_required_lanes_must_execute_and_pass"
        },
        "contract_only_policy": {
          "const": "required_but_not_yet_executable"
        },
        "scope_policy": {
          "const": "claims_are_limited_to_exact_evidence_identity"
        }
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/lane"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "uniqueNonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonemptyString"
      }
    },
    "uniqueIdentifiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "scalar": {
      "oneOf": [
        {"type": "string"},
        {"type": "integer"},
        {"type": "boolean"}
      ]
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "kind", "protocol", "entrypoint"],
      "properties": {
        "status": {
          "enum": ["executable", "contract_only"]
        },
        "kind": {
          "enum": ["jsonl_suite", "adapter"]
        },
        "protocol": {
          "$ref": "#/$defs/identifier"
        },
        "entrypoint": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/nonemptyString"}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "executable"}}
          },
          "then": {
            "properties": {
              "kind": {"const": "jsonl_suite"},
              "entrypoint": {"type": "string", "minLength": 1}
            }
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "contract_only"}}
          },
          "then": {
            "properties": {"entrypoint": {"type": "null"}}
          }
        }
      ]
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "values"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/scalar"
          }
        }
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "dimensions"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/dimension"
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirement"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "requirement": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "metric",
        "operator",
        "expected",
        "unit",
        "threshold_source",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "metric": {
          "$ref": "#/$defs/identifier"
        },
        "operator": {
          "enum": ["eq", "gte", "lte", "present"]
        },
        "expected": {
          "$ref": "#/$defs/scalar"
        },
        "unit": {
          "$ref": "#/$defs/identifier"
        },
        "threshold_source": {
          "enum": ["benchmark_contract", "certification_record", "run_manifest"]
        },
        "evidence": {
          "$ref": "#/$defs/uniqueIdentifiers"
        }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "layer",
        "description",
        "required",
        "implementation_sources",
        "harness",
        "matrices",
        "cases",
        "gates",
        "required_artifacts",
        "claim_scope"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "layer": {
          "$ref": "#/$defs/identifier"
        },
        "description": {
          "$ref": "#/$defs/nonemptyString"
        },
        "required": {
          "type": "boolean"
        },
        "implementation_sources": {
          "$ref": "#/$defs/uniqueNonemptyStrings"
        },
        "harness": {
          "$ref": "#/$defs/harness"
        },
        "matrices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/matrix"
          }
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/case"
          }
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/gate"
          }
        },
        "required_artifacts": {
          "$ref": "#/$defs/uniqueIdentifiers"
        },
        "claim_scope": {
          "$ref": "#/$defs/uniqueIdentifiers"
        }
      }
    }
  }
}
