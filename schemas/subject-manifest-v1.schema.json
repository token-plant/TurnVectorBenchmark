{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://token-plant.github.io/TurnVectorBenchmark/schemas/subject-manifest-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "subject_kind", "adapters"],
  "properties": {
    "schema_version": {"const": "turnvector.benchmark.subject-manifest.v1"},
    "id": {"$ref": "#/$defs/id"},
    "subject_kind": {"enum": ["implementation", "fixture"]},
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "command", "cwd", "lanes", "timeout_seconds"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "category": {"enum": ["core", "native", "system"]},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "cwd": {"type": "string", "minLength": 1},
          "lanes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 3600}
        }
      }
    }
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}}
}
