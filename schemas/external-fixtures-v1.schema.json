{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://token-plant.github.io/TurnVectorBenchmark/schemas/external-fixtures-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "reference_lock_sha256", "artifacts"],
  "properties": {
    "schema_version": {"const": "turnvector.benchmark.external-fixtures.v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "reference_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "kind", "size", "sha256"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "path": {"type": "string", "minLength": 1},
          "kind": {"enum": ["file", "directory"]},
          "size": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
