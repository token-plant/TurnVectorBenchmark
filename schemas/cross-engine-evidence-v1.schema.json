{
  "$defs": {
    "binding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "type": "object"
    },
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "git_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "type": "string"
    },
    "ids": {
      "items": {
        "$ref": "#/$defs/id"
      },
      "type": "array",
      "uniqueItems": true
    },
    "nonempty": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "nonnegative_integer": {
      "minimum": 0,
      "type": "integer"
    },
    "positive_integer": {
      "minimum": 1,
      "type": "integer"
    },
    "row": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "$ref": "#/$defs/id"
        },
        "comparison_form": {
          "enum": [
            "absolute",
            "paired_delta",
            "regression"
          ]
        },
        "eligibility": {
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "measurement_surface": {
          "const": "openai_serving"
        },
        "metric_id": {
          "$ref": "#/$defs/id"
        },
        "model_equivalence_class": {
          "enum": [
            "exact_artifact",
            "same_source_model",
            "shape_matched",
            "capability_demo"
          ]
        },
        "observation_level": {
          "enum": [
            "client_only",
            "declared",
            "corroborated",
            "benchmark_forced"
          ]
        },
        "pairing_id": {
          "$ref": "#/$defs/id"
        },
        "provenance_class": {
          "enum": [
            "benchmark_measurement",
            "diagnostic_import"
          ]
        },
        "raw_artifact_ids": {
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "semantic_claim": {
          "enum": [
            "serving",
            "route",
            "prefix_reuse",
            "mtp",
            "other_speculative",
            "determinism"
          ]
        },
        "unit": {
          "$ref": "#/$defs/id"
        },
        "value": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number"
            }
          ]
        },
        "workload_contract": {
          "enum": [
            "same_api_workload",
            "same_resolved_model_work"
          ]
        }
      },
      "required": [
        "case_id",
        "pairing_id",
        "metric_id",
        "unit",
        "value",
        "eligibility",
        "measurement_surface",
        "comparison_form",
        "semantic_claim",
        "observation_level",
        "provenance_class",
        "workload_contract",
        "model_equivalence_class",
        "raw_artifact_ids"
      ],
      "oneOf": [
        {
          "properties": {
            "eligibility": {
              "const": "available"
            },
            "value": {
              "type": "number"
            }
          }
        },
        {
          "properties": {
            "eligibility": {
              "const": "unavailable"
            },
            "value": {
              "type": "null"
            }
          }
        }
      ],
      "type": "object"
    },
    "session": {
      "additionalProperties": false,
      "properties": {
        "benchmark_dirty": {
          "type": "boolean"
        },
        "benchmark_revision": {
          "$ref": "#/$defs/git_sha"
        },
        "finished_at": {
          "minLength": 1,
          "type": "string"
        },
        "host_fingerprint_sha256": {
          "$ref": "#/$defs/digest"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "started_at": {
          "minLength": 1,
          "type": "string"
        },
        "target_dirty_after": {
          "type": "boolean"
        },
        "target_dirty_before": {
          "type": "boolean"
        },
        "target_revision_after": {
          "$ref": "#/$defs/git_sha"
        },
        "target_revision_before": {
          "$ref": "#/$defs/git_sha"
        }
      },
      "required": [
        "id",
        "benchmark_revision",
        "benchmark_dirty",
        "target_revision_before",
        "target_revision_after",
        "target_dirty_before",
        "target_dirty_after",
        "started_at",
        "finished_at",
        "host_fingerprint_sha256"
      ],
      "type": "object"
    },
    "statuses": {
      "additionalProperties": false,
      "properties": {
        "capability_status": {
          "enum": [
            "supported",
            "capability_unsupported",
            "profile_incompatible",
            "not_applicable",
            "environment_unavailable"
          ]
        },
        "contract_status": {
          "enum": [
            "valid",
            "invalid",
            "interrupted"
          ]
        },
        "coverage_status": {
          "enum": [
            "complete",
            "partial",
            "zero_common_cells"
          ]
        },
        "evidence_status": {
          "enum": [
            "not_evaluated",
            "publishable",
            "not_publishable"
          ]
        },
        "execution_status": {
          "enum": [
            "not_started",
            "completed",
            "partial",
            "infrastructure_failed"
          ]
        },
        "promotion_status": {
          "enum": [
            "not_evaluated",
            "not_applicable",
            "passed",
            "failed"
          ]
        }
      },
      "required": [
        "contract_status",
        "capability_status",
        "execution_status",
        "evidence_status",
        "promotion_status",
        "coverage_status"
      ],
      "type": "object"
    }
  },
  "$id": "https://token-plant.github.io/TurnVectorBenchmark/schemas/cross-engine-evidence-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "$ref": "#/$defs/binding"
    },
    "campaign_id": {
      "$ref": "#/$defs/id"
    },
    "case_plan_sha256": {
      "$ref": "#/$defs/digest"
    },
    "profile": {
      "$ref": "#/$defs/binding"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/row"
      },
      "maxItems": 1000000,
      "type": "array"
    },
    "scenario_sets": {
      "items": {
        "$ref": "#/$defs/binding"
      },
      "maxItems": 16,
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "turnvector.benchmark.cross-engine-evidence.v1"
    },
    "session": {
      "$ref": "#/$defs/session"
    },
    "statuses": {
      "$ref": "#/$defs/statuses"
    },
    "target": {
      "$ref": "#/$defs/binding"
    }
  },
  "required": [
    "schema_version",
    "campaign_id",
    "profile",
    "scenario_sets",
    "target",
    "session",
    "case_plan_sha256",
    "statuses",
    "rows",
    "artifacts"
  ],
  "type": "object"
}
