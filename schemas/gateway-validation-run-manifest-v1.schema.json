{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://token-plant.github.io/TurnVectorBenchmark/schemas/gateway-validation-run-manifest-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "source_contract_sha256",
    "session_id",
    "effective_limits",
    "transport_protocol",
    "lifecycle_case_ids",
    "transport_case_plan"
  ],
  "properties": {
    "schema_version": {
      "const": "turnvector.benchmark.gateway-validation-run-manifest.v1"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "source_contract_sha256": {"$ref": "#/$defs/digest"},
    "session_id": {"$ref": "#/$defs/id"},
    "effective_limits": {"$ref": "#/$defs/limits"},
    "transport_protocol": {"$ref": "#/$defs/protocol"},
    "lifecycle_case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "transport_case_plan": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/planned_case"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "http_write_no_progress_ns",
        "http_write_total_ns",
        "cancellation_completion_ns"
      ],
      "properties": {
        "http_write_no_progress_ns": {"type": "integer", "minimum": 1},
        "http_write_total_ns": {"type": "integer", "minimum": 1},
        "cancellation_completion_ns": {"type": "integer", "minimum": 1}
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cold_process_warmups",
        "warm_process_warmups",
        "measured_repetitions",
        "cooldown_seconds",
        "order_policy"
      ],
      "properties": {
        "cold_process_warmups": {"type": "integer", "minimum": 0},
        "warm_process_warmups": {"type": "integer", "minimum": 0},
        "measured_repetitions": {"type": "integer", "minimum": 1},
        "cooldown_seconds": {"type": "integer", "minimum": 0},
        "order_policy": {"const": "balanced"}
      }
    },
    "scalar": {"type": ["string", "integer", "boolean"]},
    "planned_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "ordinal", "parameters"],
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "ordinal": {"type": "integer", "minimum": 1},
        "parameters": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {"$ref": "#/$defs/scalar"}
        }
      }
    }
  }
}
