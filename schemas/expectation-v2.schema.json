{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://token-plant.github.io/TurnVectorBenchmark/schemas/expectation-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "description", "source_contract", "certification_policy", "lanes"],
  "properties": {
    "schema_version": {"const": "turnvector.benchmark.expectation.v2"},
    "id": {"$ref": "#/$defs/id"},
    "description": {"type": "string", "minLength": 1},
    "source_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "revision", "clean_required"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "clean_required": {"type": "boolean"}
      }
    },
    "certification_policy": {
      "const": {
        "required_lane_policy": "all_required_lanes_must_execute_and_pass",
        "unsupported_policy": "required_lane_failure",
        "scope_policy": "claims_are_limited_to_exact_evidence_identity"
      }
    },
    "lanes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/lane"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "lane": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "layer", "description", "required", "implementation_sources", "harness", "matrices", "cases", "gates", "required_artifacts", "claim_scope"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "layer": {"$ref": "#/$defs/id"}, "description": {"type": "string"}, "required": {"type": "boolean"},
        "implementation_sources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "harness": {
          "type": "object", "additionalProperties": false,
          "required": ["protocol", "runner", "suite"],
          "properties": {
            "protocol": {"$ref": "#/$defs/id"}, "runner": {"$ref": "#/$defs/id"}, "suite": {"type": "string"},
            "legacy_protocol": {"$ref": "#/$defs/id"}, "legacy_suite": {"type": "string"}
          }
        },
        "matrices": {"type": "array", "minItems": 1}, "cases": {"type": "array", "minItems": 1}, "gates": {"type": "array", "minItems": 1},
        "required_artifacts": {"$ref": "#/$defs/ids"}, "claim_scope": {"$ref": "#/$defs/ids"}
      }
    }
  }
}
