  "comparison_policy": {
    "allowed_forms": [
      "absolute",
      "paired_delta",
      "regression"
    ],
    "coverage_disclosure_required": true,
    "intersection_only": true,
    "model_equivalence_classes": [
      "exact_artifact",
      "same_source_model",
      "shape_matched",
      "capability_demo"
    ],
    "paired_order": "balanced_or_alternating",
    "ratio_aggregation": "mean_of_paired_ratios",
    "workload_contracts": [
      "same_api_workload",
      "same_resolved_model_work"
    ],
    "zero_common_cells": "no_comparison_row"
  },
  "description": "Benchmark-owned OpenAI-compatible serving comparison profile; never TurnVector production Data Plane qualification.",
