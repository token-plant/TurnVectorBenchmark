      "protocol": {
        "warmup_repetitions": 2,
        "measured_repetitions": 5,
        "cooldown_seconds": 15,
        "process_isolation": "session_reuse",
        "order_policy": "balanced",
        "cache_policy": "isolated",
        "sampling_policy": "greedy",
        "fixed_parameters": {"requests_per_trial": 24, "output_tokens": 96}
      },
      "metrics": [
        {"id": "ttft_ms", "unit": "milliseconds", "reducer": "p95"},
        {"id": "tpot_ms", "unit": "milliseconds", "reducer": "p95"},
        {"id": "stream_gap_ms", "unit": "milliseconds", "reducer": "p95"},
        {"id": "e2e_ms", "unit": "milliseconds", "reducer": "p95"},
        {"id": "queue_delay_ms", "unit": "milliseconds", "reducer": "p95"},
        {"id": "request_throughput", "unit": "requests_per_second", "reducer": "median"},
        {"id": "output_throughput", "unit": "tokens_per_second", "reducer": "median"},
        {"id": "slo_goodput_ratio", "unit": "ratio", "reducer": "median"},
        {"id": "request_error_count", "unit": "count", "reducer": "sum"},
        {"id": "route_contract_violation_count", "unit": "count", "reducer": "sum"},
        {"id": "output_mismatch_count", "unit": "count", "reducer": "sum"}
      ],
      "gates": [
        {"id": "route-purity", "metric": "route_contract_violation_count", "operator": "eq", "threshold_source": "benchmark_contract", "expected": 0, "decision": "evidence"},
        {"id": "output-correctness", "metric": "output_mismatch_count", "operator": "eq", "threshold_source": "benchmark_contract", "expected": 0, "decision": "evidence"},
        {"id": "availability", "metric": "request_error_count", "operator": "eq", "threshold_source": "benchmark_contract", "expected": 0, "decision": "promotion"},
        {"id": "ttft-bound", "metric": "ttft_ms", "operator": "lte", "threshold_source": "certification_record", "expected": null, "decision": "promotion"},
        {"id": "tpot-bound", "metric": "tpot_ms", "operator": "lte", "threshold_source": "certification_record", "expected": null, "decision": "promotion"},
        {"id": "stream-gap-bound", "metric": "stream_gap_ms", "operator": "lte", "threshold_source": "certification_record", "expected": null, "decision": "promotion"},
        {"id": "goodput-bound", "metric": "slo_goodput_ratio", "operator": "gte", "threshold_source": "certification_record", "expected": null, "decision": "promotion"}
      ],
      "required_artifacts": ["request_trace", "route_trace", "output_hashes"],
      "claim_boundaries": [
        "Closed-loop concurrency and open-loop arrival rate are separate rows.",
        "The prompt mix and SLO thresholds are frozen before execution.",
        "A smoke corpus cannot support a representative production claim."
      ]
    },
    {
      "id": "real-model-direct-performance",
      "description": "Direct generation across architecture, quantization, and prompt depth with correctness retained.",
      "activation": "core",
      "session_mode": "direct-generation",
      "claim_types": ["absolute", "paired_delta"],
      "matrices": [
        {
          "id": "generation-shape",
