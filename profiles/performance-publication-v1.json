{
  "schema_version": "turnvector.benchmark.performance-contract.v1",
  "id": "turnvector-performance-publication-v1",
  "description": "Fail-closed performance evidence and publication contract for TurnVector workloads.",
  "source_contract": {
    "repository": "TurnVector",
    "revision": "7cbfe2caef3f2f9f95a03e17eb8741ed1acf98a2",
    "clean_required": true
  },
  "publication_policy": {
    "cross_mode_comparison": "forbidden_without_shared_denominator",
    "unsupported_result": "explicit_not_publishable",
    "thresholds_frozen_before_run": true,
    "raw_trials_required": true,
    "summary_recomputed": true,
    "percentile_method": "nearest_rank"
  },
  "environment_requirements": {
    "identity_fields": [
      "device_class",
      "memory_bytes",
      "os_build",
      "resolved_runtime_sha256",
      "subject_binary_sha256",
      "model_manifest_sha256",
      "prompt_manifest_sha256",
      "certification_record_sha256"
    ],
    "host_condition_fields": [
      "power_source",
      "thermal_state_start",
      "thermal_state_end",
      "load_average_1m_start",
      "load_average_1m_end",
      "top_process_cpu_percent_start",
      "top_process_cpu_percent_end",
      "host_admission_passed"
    ],
    "admission_limits": {
      "max_load_average_1m": 2.0,
      "max_top_process_cpu_percent": 50.0
    },
    "benchmark_custody": [
      "host_conditions",
      "request_timestamps",
      "raw_trials"
    ]
  },
  "common_required_artifacts": [
    "run_manifest",
    "environment",
    "raw_trials",
    "host_samples",
    "model_manifest",
    "prompt_manifest",
    "certification_record"
  ],
  "lanes": [
    {
      "id": "online-serving-single-client",
      "description": "Isolated streaming generation with authoritative completion and client-observed latency.",
      "activation": "core",
      "session_mode": "online-serving-single-client",
      "claim_types": ["absolute", "paired_delta"],
      "matrices": [
        {
          "id": "streaming-chat",
          "dimensions": [
            {"id": "model_architecture", "values": ["dense", "moe"]},
            {"id": "quantization", "values": ["4bit", "6bit"]},
            {"id": "prompt_tokens", "values": [512, 2048]}
          ]
        }
      ],
      "protocol": {
        "warmup_repetitions": 1,
        "measured_repetitions": 3,
        "cooldown_seconds": 15,
        "process_isolation": "fresh_per_repetition",
        "order_policy": "balanced",
        "cache_policy": "isolated",
        "sampling_policy": "greedy",
        "fixed_parameters": {"output_tokens": 256, "temperature": 0}
      },
      "metrics": [
        {"id": "ttft_ms", "unit": "milliseconds", "reducer": "p95"},
        {"id": "tpot_ms", "unit": "milliseconds", "reducer": "p95"},
        {"id": "decode_tokens_per_second", "unit": "tokens_per_second", "reducer": "median"},
        {"id": "effective_prefill_tokens_per_second", "unit": "tokens_per_second", "reducer": "median"},
        {"id": "completion_contract_violation_count", "unit": "count", "reducer": "sum"},
        {"id": "process_error_count", "unit": "count", "reducer": "sum"},
        {"id": "output_mismatch_count", "unit": "count", "reducer": "sum"}
      ],
      "gates": [
        {"id": "completion-contract", "metric": "completion_contract_violation_count", "operator": "eq", "threshold_source": "benchmark_contract", "expected": 0, "decision": "evidence"},
        {"id": "output-correctness", "metric": "output_mismatch_count", "operator": "eq", "threshold_source": "benchmark_contract", "expected": 0, "decision": "evidence"},
        {"id": "availability", "metric": "process_error_count", "operator": "eq", "threshold_source": "benchmark_contract", "expected": 0, "decision": "promotion"},
        {"id": "ttft-bound", "metric": "ttft_ms", "operator": "lte", "threshold_source": "certification_record", "expected": null, "decision": "promotion"},
        {"id": "tpot-bound", "metric": "tpot_ms", "operator": "lte", "threshold_source": "certification_record", "expected": null, "decision": "promotion"},
        {"id": "decode-throughput", "metric": "decode_tokens_per_second", "operator": "gte", "threshold_source": "certification_record", "expected": null, "decision": "promotion"}
      ],
      "required_artifacts": ["request_trace", "process_audit", "output_hashes"],
      "claim_boundaries": [
        "Client-observed prefill includes request and first-chunk overhead.",
        "Transport completion and output correctness are separate gates.",
        "Rows from other session modes are not directly comparable."
      ]
    },
    {
      "id": "online-serving-load",
      "description": "Closed-loop and open-loop serving load with latency tails, queueing, throughput, and goodput.",
      "activation": "core",
      "session_mode": "online-serving-load",
      "claim_types": ["absolute", "paired_delta"],
      "matrices": [
        {
          "id": "load-shape",
          "dimensions": [
            {"id": "model_architecture", "values": ["dense", "moe"]},
            {"id": "arrival_mode", "values": ["closed_loop", "open_loop"]},
            {"id": "load_level", "values": ["nominal", "saturated"]}
