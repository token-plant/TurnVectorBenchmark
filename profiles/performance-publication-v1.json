        {"id": "ttft_ms", "unit": "milliseconds", "reducer": "p95"},
        {"id": "peak_memory_bytes", "unit": "bytes", "reducer": "max"},
        {"id": "output_mismatch_count", "unit": "count", "reducer": "sum"},
        {"id": "degeneracy_violation_count", "unit": "count", "reducer": "sum"},
        {"id": "route_contract_violation_count", "unit": "count", "reducer": "sum"}
      ],
      "gates": [
        {"id": "output-correctness", "metric": "output_mismatch_count", "operator": "eq", "threshold_source": "benchmark_contract", "expected": 0, "decision": "evidence"},
        {"id": "non-degenerate-output", "metric": "degeneracy_violation_count", "operator": "eq", "threshold_source": "benchmark_contract", "expected": 0, "decision": "evidence"},
        {"id": "route-purity", "metric": "route_contract_violation_count", "operator": "eq", "threshold_source": "benchmark_contract", "expected": 0, "decision": "evidence"},
        {"id": "decode-throughput", "metric": "decode_tokens_per_second", "operator": "gte", "threshold_source": "certification_record", "expected": null, "decision": "promotion"},
        {"id": "prefill-throughput", "metric": "prefill_tokens_per_second", "operator": "gte", "threshold_source": "certification_record", "expected": null, "decision": "promotion"},
        {"id": "memory-bound", "metric": "peak_memory_bytes", "operator": "lte", "threshold_source": "certification_record", "expected": null, "decision": "promotion"}
      ],
      "required_artifacts": ["output_hashes", "route_trace", "memory_samples"],
      "claim_boundaries": [
        "Direct generation is not an online serving latency claim.",
        "Separate-run comparisons are directional unless a shared paired denominator is recorded.",
