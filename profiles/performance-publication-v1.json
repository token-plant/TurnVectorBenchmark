      "protocol": {
        "warmup_repetitions": 2,
        "measured_repetitions": 5,
        "cooldown_seconds": 15,
        "process_isolation": "fresh_per_cell",
        "order_policy": "balanced",
        "cache_policy": "isolated",
        "sampling_policy": "greedy",
        "fixed_parameters": {"output_tokens": 128}
      },
      "metrics": [
        {"id": "decode_tokens_per_second", "unit": "tokens_per_second", "reducer": "median"},
