          "operator": "eq",
          "expected": false,
          "unit": "boolean",
          "threshold_source": "run_manifest",
          "evidence": ["manifest", "measurement_trace"]
        }
      ],
      "required_artifacts": ["manifest", "environment", "plan_trace", "oracle_trace", "latency_samples", "measurement_trace", "report", "checksums"],
      "claim_scope": ["scheduler_performance_envelope"]
    },
