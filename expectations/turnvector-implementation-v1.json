        "docs/adr/0007-support-open-work-kinds-through-fixed-scheduling-semantics.md",
        "docs/adr/0015-use-deterministic-deadline-aware-weighted-service-selection.md",
        "docs/adr/0032-separate-the-pure-core-from-protocol-and-io.md"
      ],
      "harness": {
