          "threshold_source": "certification_record",
          "evidence": ["latency_samples", "environment"]
        },
        {
          "id": "decision-throughput",
          "metric": "decisions_per_second",
          "operator": "gte",
          "expected": "certification_record.decisions_per_second",
          "unit": "count",
          "threshold_source": "certification_record",
          "evidence": ["latency_samples", "environment"]
        },
        {
