      ],
      "cases": [
        {
          "id": "weighted-service",
          "requirement": "Continuously runnable Models receive Engine Service in exact proportion to Model Weight."
        },
        {
          "id": "idle-reentry",
          "requirement": "A returning Model aligns to the runnable baseline and receives no stored credit."
        },
        {
          "id": "safety-before-urgency",
          "requirement": "Unsafe candidates are removed before Latest Safe Start and ledger selection."
        }
      ],
      "gates": [
        {
          "id": "oracle-selection",
          "metric": "oracle_selection_mismatch_count",
          "operator": "eq",
          "expected": 0,
          "unit": "count",
          "threshold_source": "benchmark_contract",
          "evidence": ["trace", "report"]
        },
        {
          "id": "receipt-accounting",
          "metric": "receipt_ledger_mismatch_count",
          "operator": "eq",
          "expected": 0,
          "unit": "count",
          "threshold_source": "benchmark_contract",
          "evidence": ["trace", "report"]
        },
        {
          "id": "deterministic-replay",
          "metric": "plan_trace_hash_mismatch_count",
          "operator": "eq",
          "expected": 0,
          "unit": "count",
          "threshold_source": "benchmark_contract",
          "evidence": ["trace", "report"]
        }
      ],
      "required_artifacts": ["manifest", "environment", "trace", "report", "checksums"],
      "claim_scope": ["scheduler_policy_conformance"]
    },
    {
      "id": "scheduler-performance",
      "layer": "runtime-core",
      "description": "Release-mode pure-Core scheduling latency and throughput measured independently from adapter IPC.",
      "required": true,
      "implementation_sources": [
