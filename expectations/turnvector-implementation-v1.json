{
  "schema_version": "turnvector.benchmark.expectation.v1",
  "id": "turnvector-implementation-v1",
  "description": "Normative benchmark expectations derived from the TurnVector implementation contract; harness availability never removes required coverage.",
  "source_contract": {
    "repository": "TurnVector",
    "revision": "7cbfe2caef3f2f9f95a03e17eb8741ed1acf98a2",
    "clean_required": true
  },
  "certification_policy": {
    "required_lane_policy": "all_required_lanes_must_execute_and_pass",
    "contract_only_policy": "required_but_not_yet_executable",
    "scope_policy": "claims_are_limited_to_exact_evidence_identity"
  },
  "lanes": [
    {
      "id": "core-event-replay",
      "layer": "runtime-core",
      "description": "Deterministic Runtime Core state transitions, effect ordering, fault handling, and replay.",
      "required": true,
      "implementation_sources": [
        "CONTEXT.md",
        "docs/adr/0005-run-pure-scheduling-and-backend-execution-in-one-device-loop.md",
        "docs/adr/0016-distinguish-plan-rejection-from-started-turn-outcomes.md",
        "docs/adr/0032-separate-the-pure-core-from-protocol-and-io.md",
        "docs/adr/0033-commit-core-transitions-atomically-and-fail-closed.md"
      ],
      "harness": {
        "status": "contract_only",
        "kind": "adapter",
        "protocol": "turnvector.benchmark.core-replay.v1",
        "entrypoint": null
      },
      "matrices": [
        {
          "id": "effect-result-replay",
          "dimensions": [
            {
              "id": "result",
              "values": ["completed", "failed", "cancelled", "indeterminate"]
            },
            {
              "id": "sequence_relation",
              "values": ["current", "duplicate", "late", "unknown", "stale_generation"]
            }
          ]
        }
      ],
      "cases": [
        {
          "id": "deterministic-state",
          "requirement": "Identical ordered Core Events produce identical outcomes, effects, invariant results, and state hashes."
        },
        {
          "id": "atomic-failure",
          "requirement": "Sequence or invariant failure preserves the prior state and exposes no effect."
        },
        {
          "id": "effect-idempotence",
          "requirement": "Duplicate, late, unknown, and generation-mismatched Effect Results never reapply state."
        },
        {
          "id": "cancellation-order",
          "requirement": "Event Sequence alone resolves cancellation before or after Receipt commit and output publication."
        }
      ],
      "gates": [
        {
          "id": "replay-hash",
          "metric": "replay_hash_mismatch_count",
          "operator": "eq",
          "expected": 0,
          "unit": "count",
          "threshold_source": "benchmark_contract",
          "evidence": ["event_trace", "state_hashes"]
        },
        {
          "id": "invariant-safety",
          "metric": "committed_invariant_violation_count",
          "operator": "eq",
          "expected": 0,
          "unit": "count",
          "threshold_source": "benchmark_contract",
          "evidence": ["event_trace", "invariant_results"]
        },
        {
          "id": "failed-transition-effects",
          "metric": "effects_exposed_after_failed_transition_count",
          "operator": "eq",
          "expected": 0,
          "unit": "count",
          "threshold_source": "benchmark_contract",
          "evidence": ["effect_trace"]
        }
      ],
      "required_artifacts": ["manifest", "event_trace", "state_hashes", "invariant_results", "report"],
      "claim_scope": ["runtime_core_conformance"]
    },
    {
      "id": "scheduler-policy",
      "layer": "runtime-core",
      "description": "Safety-first urgency and runnable-only weighted Engine Service selection.",
      "required": true,
      "implementation_sources": [
        "CONTEXT.md",
        "docs/adr/0003-use-runnable-only-weighted-engine-service-fairness.md",
        "docs/adr/0004-apply-resource-safety-before-urgency-and-fairness.md",
        "docs/adr/0007-support-open-work-kinds-through-fixed-scheduling-semantics.md",
        "docs/adr/0010-use-three-phase-aware-service-classes.md",
        "docs/adr/0015-use-deterministic-deadline-aware-weighted-service-selection.md"
      ],
      "harness": {
        "status": "executable",
        "kind": "jsonl_suite",
        "protocol": "turnvector.benchmark.driver.v1",
        "entrypoint": "../suites/scheduler-policy-v1.json"
